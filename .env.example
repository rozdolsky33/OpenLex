# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database
DATABASE_URL=postgresql+asyncpg://openlex:openlex@db:5432/openlex

# NY Open Legislation (free signup at legislation.nysenate.gov)
NY_OPEN_LEG_API_KEY=
NY_OPEN_LEG_BASE_URL=https://legislation.nysenate.gov/api/3

# Embedding model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Auth (generate a real secret with: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Grafana admin password -- pin it so it doesn't drift (kube-prometheus-stack otherwise mints a
# new random one on every ArgoCD sync, which breaks `admin` login). Generate one with:
# openssl rand -base64 24. Anonymous access works without login regardless; this is for editing.
GRAFANA_ADMIN_PASSWORD=

# ArgoCD admin password (kind only) -- pin it so `admin` login is a known value instead of the
# chart's random argocd-initial-admin-secret. scripts/kind/argocd-admin-password.sh (a step in
# scripts/kind-master.sh up) bcrypts this and patches the argocd-secret. Generate one with:
# openssl rand -base64 24. Login: admin / <this value>.
ARGOCD_ADMIN=

# Demo users (seeded, tier-gated) -- run scripts/seed/seed-demo-users.sh after setting these to
# create/refresh the three fixed demo logins. Registration is disabled for this demo (see
# apps/api/src/openlex_api/routers/auth.py), so these are the only accounts that can log in.
# The passwords below are placeholders committed in this example file -- anyone can read them
# on GitHub. Replace them with your own strong, unique passwords (e.g. `openssl rand -base64
# 18` per tier) in your real .env before running against anything but a fully local, throwaway
# stack -- never reuse these literal values for a shared or deployed instance.
DEMO_SILVER_EMAIL=bob@example.com
DEMO_SILVER_PASSWORD=demo-silver-pw
DEMO_GOLD_EMAIL=steve@example.com
DEMO_GOLD_PASSWORD=demo-gold-pw
DEMO_PLATINUM_EMAIL=jennifer@example.com
DEMO_PLATINUM_PASSWORD=demo-platinum-pw

# Case-law seed curation only (free signup at courtlistener.com) -- used once, out-of-band,
# to fetch real opinion text for pipelines/ingestion/ny_case_law/seed_cases.json. Not read by
# the running app at runtime -- case-law ingestion has no live-fetch pipeline (see ADR-0006).
COURTLISTENER_API_TOKEN=

# GHCR pull-secret bootstrap only (personal access token, "read:packages" scope) -- used once,
# out-of-band, by scripts/kind/ghcr-pull-secret-bootstrap.sh to let the kind cluster pull
# private images from ghcr.io. Not read by the running app at runtime -- never wired into
# openlex_shared.config.Settings or any application code path (same framing as
# COURTLISTENER_API_TOKEN above).
GHCR_USERNAME=
GHCR_PAT=

# Argo CD Image Updater git write-back (kind only) -- a GitHub PAT with `repo` (write) scope so
# the updater can commit image-tag updates to the `gitops/kind` branch. Different from GHCR_PAT
# (which is read:packages only). Used once, out-of-band, by scripts/kind/secrets-bootstrap.sh;
# never read by the running app. Leave empty to disable image automation (deploy.yml still
# builds+pushes images; you'd bump the overlay tags by hand).
GIT_WRITE_TOKEN=
