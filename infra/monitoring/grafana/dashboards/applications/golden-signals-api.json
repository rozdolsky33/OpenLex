{
  "id": null,
  "uid": "openlex-golden-signals-api",
  "title": "Golden Signals — API",
  "description": "Traffic/error/latency/saturation for openlex-api. Traffic, error-rate, and p50/p95/p99 latency are sourced from openlex_http_requests_total and openlex_http_request_duration_seconds (apps/api/src/openlex_api/http_metrics.py) -- a hand-rolled Prometheus RED middleware added because opentelemetry-instrumentation-fastapi's internal duration histogram silently no-ops here (no MeterProvider registered, see telemetry.py). CPU/memory saturation come from cAdvisor.",
  "tags": ["openlex", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic — requests/sec by route (rate, 5m)",
      "description": "sum by (route) (rate(openlex_http_requests_total[5m])) -- /metrics itself is excluded from these counters (see http_metrics.py), so this reflects real client traffic only.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(openlex_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate — 5xx/4xx as % of total (rate, 5m)",
      "description": "sum(rate(openlex_http_requests_total{status_class=~\"4xx|5xx\"}[5m])) / clamp_min(sum(rate(openlex_http_requests_total[5m])), 1e-9) by route -- server errors (5xx) and client errors (4xx) tracked separately since only 5xx is actionable on-call, 4xx is often client misuse. clamp_min on the denominator avoids a 0/0 NaN (dropped by Grafana as a gap) for a route that has traffic but hits a rate=0 bucket.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(openlex_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (route) (rate(openlex_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx — {{route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(openlex_http_requests_total{status_class=\"4xx\"}[5m])) / clamp_min(sum by (route) (rate(openlex_http_requests_total[5m])), 1e-9)",
          "legendFormat": "4xx — {{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency — p50/p95/p99 by route (5m)",
      "description": "histogram_quantile over openlex_http_request_duration_seconds_bucket by route -- averages hide the tail, so this deliberately only ever shows percentiles.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(openlex_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 — {{route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(openlex_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 — {{route}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(openlex_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 — {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage — openlex-api pods (cores)",
      "description": "rate() of container_cpu_usage_seconds_total for openlex-api pods, summed across containers per pod.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"openlex\", pod=~\"openlex-api-.*\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory working set — openlex-api pods (bytes)",
      "description": "sum by (pod) (container_memory_working_set_bytes) for openlex-api pods -- aggregated because cAdvisor emits both per-container and pod-level rows for the same pod, which without the sum produces duplicate legend entries.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openlex\", pod=~\"openlex-api-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
