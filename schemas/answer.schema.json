{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlex.dev/schemas/answer.schema.json",
  "title": "Answer",
  "description": "The grounded-answer response contract. Generated from legal_models.schemas.QueryResponse \u2014 keep in sync. See the grounded-answer-contract skill.",
  "$defs": {
    "Citation": {
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "doc_type": {
          "title": "Doc Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "court": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "citation",
        "doc_type",
        "snippet"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "disclaimer": {
      "default": "This tool provides general legal information about New York landlord-tenant law, not legal advice. It is not a substitute for consultation with a licensed attorney and does not create an attorney-client relationship.",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "answer",
    "citations",
    "abstained"
  ],
  "type": "object"
}
